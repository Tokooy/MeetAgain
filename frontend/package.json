{
  "name": "meetagain-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src e2e vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "lucide-react": "1.73.0",
    "maplibre-gl": "6.18.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.10.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
